#!/usr/bin/env bash
# =============================================================================
# pre-commit hook — DialogaR ISO 27001 Compliance
#
# Controles:
#   A.8.2  — Clasificación de información (encabezados y roxygen2)
#   A.9.4  — Control de acceso (archivos sensibles)
#   A.12.1 — Gestión de cambios (encabezados en archivos nuevos)
#   A.12.4 — Registro de actividad (sin PII en logs/errores)
#   A.14.2 — Seguridad en desarrollo (dependencias)
#
# Instalación: bash inst/hooks/install_hooks.sh
# =============================================================================

set -uo pipefail

ERRORS=0
WARNINGS=0
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RESET='\033[0m'

err()  { echo -e "${RED}❌ [$1]${RESET} $2"; ERRORS=$((ERRORS + 1)); }
warn() { echo -e "${YELLOW}⚠️  [$1]${RESET} $2"; WARNINGS=$((WARNINGS + 1)); }
info() { echo -e "   ${YELLOW}→${RESET} $1"; }

# ─────────────────────────────────────────────────────────────────────────────
# 1. ARCHIVOS SENSIBLES — no deben llegar al índice de git
#    Control ISO 27001: A.9.4
# ─────────────────────────────────────────────────────────────────────────────

SENSITIVE_PATTERNS=(
  "\.Renviron$"
  "\.Renviron\..*$"
  "\.token$"
  "\.httr-oauth$"
  "credentials\.json$"
  "service[-_]account.*\.json$"
  "\.env$"
  "\.env\..*$"
  "secrets\.R$"
  "secrets\.r$"
)

STAGED_FILES=$(git diff --cached --name-only)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
  matches=$(echo "$STAGED_FILES" | grep -E "$pattern" || true)
  if [[ -n "$matches" ]]; then
    err "A.9.4" "Archivo sensible en staging: $matches"
    info "Remover con: git reset HEAD $matches"
    info "Agregar a .gitignore para evitar futuros accidentes"
  fi
done

# ─────────────────────────────────────────────────────────────────────────────
# 2. ARCHIVOS .rds CON POSIBLES DATOS REALES
#    Control ISO 27001: A.9.4 / A.8.2
# ─────────────────────────────────────────────────────────────────────────────

RDS_STAGED=$(echo "$STAGED_FILES" | grep -E "\.rds$" || true)
if [[ -n "$RDS_STAGED" ]]; then
  warn "A.9.4" "Archivos .rds en staging (pueden contener datos reales):"
  for f in $RDS_STAGED; do
    info "$f"
  done
  info "¿Son fixtures de tests? Si es así, ignorar. Si son datos reales, remover del commit."
fi

# ─────────────────────────────────────────────────────────────────────────────
# 3. ARCHIVOS R NUEVOS EN R/ — deben tener encabezado de módulo
#    Control ISO 27001: A.12.1 (Trazabilidad)
# ─────────────────────────────────────────────────────────────────────────────

NEW_R_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E "^R/.*\.R$" || true)

for file in $NEW_R_FILES; do
  if [[ ! -f "$file" ]]; then continue; fi

  # Verificar que existe algún encabezado de módulo (campo Datos: es el crítico)
  if ! grep -qiE "^#\s*(Datos|Data)\s*:" "$file"; then
    err "A.12.1" "Nuevo archivo sin campo 'Datos:' en encabezado: $file"
    info "Agregar bloque de encabezado al inicio (ver CLAUDE.md § Encabezado obligatorio)"
    info "Mínimo requerido: # Datos : PÚBLICO | INTERNO | CONFIDENCIAL"
  fi

  # Verificar que existe campo Módulo o equivalente
  if ! grep -qiE "^#\s*(Módulo|Modulo|Módulo|MÓDULO|REPORTE|SCRIPT)\s*" "$file"; then
    warn "A.12.1" "Nuevo archivo sin identificador de módulo: $file"
    info "Agregar campo # Módulo: <nombre> en el encabezado"
  fi
done

# ─────────────────────────────────────────────────────────────────────────────
# 4. FUNCIONES EXPORTADAS NUEVAS — deben tener @section Seguridad y Privacidad
#    Control ISO 27001: A.8.2
# ─────────────────────────────────────────────────────────────────────────────

MODIFIED_R=$(echo "$STAGED_FILES" | grep -E "^R/.*\.R$" || true)

for file in $MODIFIED_R; do
  if [[ ! -f "$file" ]]; then continue; fi

  # ¿El diff agrega nuevas líneas @export?
  new_exports=$(git diff --cached "$file" 2>/dev/null | grep "^+.*@export" | grep -v "^+++" || true)
  if [[ -n "$new_exports" ]]; then
    # ¿El archivo completo tiene @section Seguridad?
    if ! grep -q "@section Seguridad y Privacidad" "$file"; then
      err "A.8.2" "Nueva función @export en '$file' sin bloque @section Seguridad y Privacidad"
      info "Agregar a cada función exportada que toque datos INTERNO o CONFIDENCIAL"
    fi
  fi
done

# ─────────────────────────────────────────────────────────────────────────────
# 5. EXPOSICIÓN DE PII EN MENSAJES DE ERROR / LOG
#    Control ISO 27001: A.12.4
#
#    Columnas PII identificadas en DialogaR:
#      nombre, a_paterno, a_materno, nombre_completo, telefono, domicilio,
#      encuestado, celular, correo, direccion
# ─────────────────────────────────────────────────────────────────────────────

PII_COLUMNS="nombre|a_paterno|a_materno|nombre_completo|telefono|domicilio|encuestado|celular|correo|direccion"

# Patrón: stop/message/warning/cat que incluyan $<columna_pii> o [[<columna_pii>]]
PII_IN_ERROR=$(git diff --cached -U0 2>/dev/null \
  | grep "^+" \
  | grep -v "^+++" \
  | grep -E "(stop|message|warning|cat)\s*\(" \
  | grep -E "\\\$($PII_COLUMNS)|\\[\\[.($PII_COLUMNS).\]\]" \
  || true)

if [[ -n "$PII_IN_ERROR" ]]; then
  err "A.12.4" "Posible exposición de PII en mensaje de error o log:"
  while IFS= read -r line; do
    info "$line"
  done <<< "$PII_IN_ERROR"
  info "Usar IDs, índices o conteos en lugar de valores de columnas sensibles"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 6. print() / message() SOBRE OBJETOS QUE PARECEN DATA FRAMES COMPLETOS
#    Control ISO 27001: A.12.4
# ─────────────────────────────────────────────────────────────────────────────

PRINT_DF=$(git diff --cached -U0 2>/dev/null \
  | grep "^+" \
  | grep -v "^+++" \
  | grep -E "^\+\s*(print|message|cat)\s*\((df|datos|insumos|encuestados|contactos|encuesta)\b" \
  || true)

if [[ -n "$PRINT_DF" ]]; then
  warn "A.12.4" "Posible log de data frame completo (riesgo de filtrar PII):"
  while IFS= read -r line; do
    info "$line"
  done <<< "$PRINT_DF"
  info "Si es debug temporal, envolver en: if (isTRUE(getOption('dialoga.debug'))) { ... }"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 7. CREDENCIALES HARDCODEADAS
#    Control ISO 27001: A.9.4 / A.10
# ─────────────────────────────────────────────────────────────────────────────

HARDCODED_CREDS=$(git diff --cached -U0 2>/dev/null \
  | grep "^+" \
  | grep -v "^+++" \
  | grep -iE "(password|passwd|secret|api_key|token)\s*=\s*[\"'][^\"']{4,}" \
  | grep -v "Sys\.getenv\|keyring\|\.Renviron\|ejemplo\|example\|placeholder\|YOUR_" \
  || true)

if [[ -n "$HARDCODED_CREDS" ]]; then
  err "A.9.4" "Posible credencial hardcodeada detectada:"
  while IFS= read -r line; do
    info "$line"
  done <<< "$HARDCODED_CREDS"
  info "Mover a .Renviron y acceder via Sys.getenv()"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 8. PAQUETES NUEVOS EN DESCRIPTION — verificación manual obligatoria
#    Control ISO 27001: A.14.2
# ─────────────────────────────────────────────────────────────────────────────

if echo "$STAGED_FILES" | grep -q "^DESCRIPTION$"; then
  NEW_DEPS=$(git diff --cached DESCRIPTION 2>/dev/null \
    | grep "^+" \
    | grep -v "^+++" \
    | grep -E "^\+\s+\w+\s*(\(|,)" \
    | grep -v "^++" \
    || true)

  if [[ -n "$NEW_DEPS" ]]; then
    warn "A.14.2" "Nuevas dependencias detectadas en DESCRIPTION:"
    while IFS= read -r line; do
      info "$line"
    done <<< "$NEW_DEPS"
    info "Verificar: en CRAN, mantenimiento activo (<2 años), sin conexiones de red no declaradas"
    info "Documentar justificación en el cuerpo del commit"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# RESULTADO
# ─────────────────────────────────────────────────────────────────────────────

echo ""
if [[ $ERRORS -gt 0 ]]; then
  echo -e "${RED}🔒 Pre-commit BLOQUEADO — $ERRORS error(es) de cumplimiento ISO 27001${RESET}"
  if [[ $WARNINGS -gt 0 ]]; then
    echo -e "${YELLOW}   + $WARNINGS advertencia(s) adicional(es)${RESET}"
  fi
  echo    "   Revisar CLAUDE.md § Seguridad y Cumplimiento para guía de corrección."
  echo    "   Para omitir en emergencia (no recomendado): git commit --no-verify"
  exit 1
elif [[ $WARNINGS -gt 0 ]]; then
  echo -e "${YELLOW}⚠️  Pre-commit: $WARNINGS advertencia(s) — commit permitido${RESET}"
  echo    "   Revisar advertencias antes de continuar."
  exit 0
else
  echo -e "${GREEN}✅ Pre-commit ISO 27001: sin problemas detectados.${RESET}"
  exit 0
fi
